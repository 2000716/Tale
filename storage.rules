rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/adminEmails/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/adminEmails/$(request.auth.token.email.lower())).data.enabled == true;
    }

    match /profile-avatars/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
