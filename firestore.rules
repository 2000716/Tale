rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())).data.enabled == true;
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sections/{sectionId}/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.get('isDefault', false) == (profileId == 'default');
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.get('isDefault', false) == resource.data.get('isDefault', false)
          && (profileId != 'default' || request.resource.data.get('isDefault', false) == true);
        allow delete: if signedIn()
          && request.auth.uid == userId
          && profileId != 'default'
          && resource.data.get('isDefault', false) != true;

        match /history/{historyId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
        }

        match /favorites/{favoriteId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
        }
      }
    }

    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    match /profileAvatars/{avatarId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /employeeEmails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /adminEmails/{emailId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}