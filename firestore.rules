rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())).data.enabled == true;
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sections/{sectionId}/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.role == 'user';
      allow update, delete: if false;
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    match /employeeEmails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /adminEmails/{emailId} {
      allow read: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == emailId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}