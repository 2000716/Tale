rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())).data.enabled != false;
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sections/{sectionId}/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    match /employeeEmails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /adminEmails/{emailId} {
      allow read: if signedIn() && request.auth.token.email.lower() == emailId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}